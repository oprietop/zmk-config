// https://github.com/urob/zmk
// https://github.com/urob/zmk-config/tree/main

// Default includes

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

// Mod-Tap

&mt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = 100>;
};

// Layer-tap

&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <100>;
};

// Mouse defines/includes

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1800  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10
#include <dt-bindings/zmk/pointing.h>

// Mouse movement

&mmv {
  acceleration-exponent = <1>;      // 1
  time-to-max-speed-ms = <750>;     // 300
  delay-ms = <0>;                   // 0
};

#define U_MS_U &mmv MOVE_UP
#define U_MS_D &mmv MOVE_DOWN
#define U_MS_L &mmv MOVE_LEFT
#define U_MS_R &mmv MOVE_RIGHT

// Mouse Wheel

&msc {
    acceleration-exponent = <0>;    // 0
    time-to-max-speed-ms = <1>;     // 300
    delay-ms = <0>;                 // 0
};

#define U_WH_U &msc SCRL_UP
#define U_WH_D &msc SCRL_DOWN
#define U_WH_L &msc SCRL_LEFT
#define U_WH_R &msc SCRL_RIGHT

// Keymap

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&none  &kp Q         &kp W        &kp F       &kp P        &mt RIGHT_ALT B    &mt RALT J       &kp L           &kp U           &kp Y            &kp SEMI         &none
&none  &kp  A        &kp R        &kp S       &kp T        &kp G              &kp M            &kp N           &kp E           &kp I            &kp O            &none
&none  &mt LCTRL Z   &mt LMETA X  &mt LALT C  &kp D        &kp V              &kp K            &kp H           &mt LALT COMMA  &mt RGUI PERIOD  &mt RCTRL SLASH  &none
                                  &none       &lt 1 SPACE  &lt 3 TAB          &mt RSHIFT DEL   &lt 2 BACKSPACE &none
            >;
        };

        Lower {
            bindings = <
&none  &kp ESC    &kp K_COPY  U_WH_U        &kp K_CUT   &kp K_PASTE  &kp PAGE_UP    &mkp LCLK  U_MS_U    &mkp RCLK  &mkp MCLK  &none
&none  &kp TAB    U_WH_L      U_WH_D        U_WH_R      &mkp MCLK    &kp HOME       U_MS_L     U_MS_D    U_MS_R     &kp END    &none
&none  &kp LCTRL  &kp LSHFT   &kp LEFT_GUI  &mkp LCLK   &mkp RCLK    &kp PAGE_DOWN  &kp LEFT   &kp DOWN  &kp UP     &kp RIGHT  &none
                              &none         &trans      &trans       &kp INS        &kp RET    &none
            >;
        };

        Raise {
            bindings = <
&none  &kp EXCL  &kp AT  &kp HASH  &kp DOLLAR  &kp PERCENT  &kp CARET  &kp AMPS  &kp ASTERISK  &kp LPAR  &kp RPAR  &none
&none  &kp N1    &kp N2  &kp N3    &kp N4      &kp N5       &kp N6     &kp N7    &kp N8        &kp N9    &kp N0    &none
&none  &kp F1    &kp F2  &kp F3    &kp F4      &kp F5       &kp F6     &kp F7    &kp F8        &kp F9    &kp F10   &none
                         &none     &kp F11     &kp F12      &trans     &trans    &none
            >;
        };

        Extra {
            bindings = <
&none  &kp LNLCK  &kp C_NEXT  &kp C_VOLUME_UP    &bt BT_NXT      &kp PSCRN       &kp LBRC   &kp LBKT   &kp RBKT   &kp RBRC  &kp PIPE   &none
&none  &kp LCAPS  &kp C_PREV  &kp C_VOLUME_DOWN  &bt BT_PRV      &kp C_BRI_UP    &kp TILDE  &kp GRAVE  &kp SQT    &kp DQT   &kp BSLH   &none
&none  &kp LSLCK  &kp C_PLAY  &kp C_MUTE         &bt BT_CLR_ALL  &kp C_BRI_DN    &kp UNDER  &kp MINUS  &kp EQUAL  &kp PLUS  &kp SLASH  &none
                                      &none      &trans          &studio_unlock  &trans     &trans     &none
            >;
        };
    };
};
