// https://github.com/urob/zmk
// https://github.com/urob/zmk-config/tree/main

// Default includes

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

// Mod-Tap

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <150>;
    quick-tap-ms = <150>;
};

// Layer-tap

&lt {
    flavor = "tap-preferred";
    tapping-term-ms = <150>;
    quick-tap-ms = <150>;
};

// Mouse defines/includes

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1800  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10
#include <dt-bindings/zmk/pointing.h>

// Mouse movement

&mmv {
  acceleration-exponent = <1>;      // 1
  time-to-max-speed-ms = <750>;     // 300
  delay-ms = <0>;                   // 0
};

#define U_MS_U &mmv MOVE_UP
#define U_MS_D &mmv MOVE_DOWN
#define U_MS_L &mmv MOVE_LEFT
#define U_MS_R &mmv MOVE_RIGHT

// Mouse Wheel

&msc {
    acceleration-exponent = <0>;    // 0
    time-to-max-speed-ms = <1>;     // 300
    delay-ms = <0>;                 // 0
};

#define U_WH_U &msc SCRL_UP
#define U_WH_D &msc SCRL_DOWN
#define U_WH_L &msc SCRL_LEFT
#define U_WH_R &msc SCRL_RIGHT

// Combos

/ {
    combos {
        compatible = "zmk,combos";
        //combo_lshift {
        //    timeout-ms = <50>;
        //    key-positions = <13 14>;
        //    bindings = <&kp LSHIFT>;
        //};
        //combo_rshift {
        //    timeout-ms = <50>;
        //    key-positions = <21 22>;
        //    bindings = <&kp RSHIFT>;
        //};
        bluetooth {
            bindings = <&mo 3>;
            key-positions = <37 40>;
        };
    };

    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_LEFT";
            bindings = <&kp>, <&kp>;
    
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35>;
            hold-trigger-on-release;
        };
    
        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_RIGHT";
            bindings = <&kp>, <&kp>;
    
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&none  &kp Q         &kp W         &kp F        &kp P          &hml RIGHT_ALT B   &hmr RALT J       &kp L           &kp U           &kp Y            &kp SEMI         &none
&none  &hml LCTRL A  &hml LMETA R  &hml LALT S  &hml LSHIFT T  &kp G              &kp  M            &hmr RSHIFT N   &hmr LALT E     &hmr RMETA I     &hmr RCTRL O     &none
&none  &kp  Z        &kp X         &kp C        &kp D          &kp V              &kp  K            &kp H           &kp COMMA       &kp PERIOD       &kp SLASH        &none
                                   &none        &kp TAB        &lt 1 SPACE        &lt  2 BACKSPACE  &kp DEL         &none
            >;
        };

        Lower {
            bindings = <
&none  &kp ESC    &kp K_COPY  U_WH_U        &kp K_CUT   &kp K_PASTE  &kp PAGE_UP    &mkp LCLK  U_MS_U    &mkp RCLK  &mkp MCLK  &none
&none  &kp TAB    U_WH_L      U_WH_D        U_WH_R      &mkp MCLK    &kp HOME       U_MS_L     U_MS_D    U_MS_R     &kp END    &none
&none  &kp LCTRL  &kp LSHFT   &kp LEFT_GUI  &mkp LCLK   &mkp RCLK    &kp PAGE_DOWN  &kp LEFT   &kp DOWN  &kp UP     &kp RIGHT  &none
                              &none         &trans      &trans       &kp RET        &kp INS    &none
            >;
        };

        Raise {
            bindings = <
&none  &kp EXCL  &kp AT  &kp HASH  &kp DOLLAR  &kp PERCENT  &kp CARET  &kp AMPS  &kp ASTERISK  &kp LPAR  &kp RPAR  &none
&none  &kp N1    &kp N2  &kp N3    &kp N4      &kp N5       &kp N6     &kp N7    &kp N8        &kp N9    &kp N0    &none
&none  &kp F1    &kp F2  &kp F3    &kp F4      &kp F5       &kp F6     &kp F7    &kp F8        &kp F9    &kp F10   &none
                         &none     &kp F11     &kp RET      &trans     &kp F12   &none
            >;
        };

        Bluetooth {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans  &trans  &trans  &trans  &bt BT_CLR  &trans
&trans  &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans      &trans
&trans  &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans      &trans
                                    &trans        &trans        &trans          &trans  &trans  &trans
            >;
        };

        Extra {
            bindings = <
&none  &kp LNLCK  &kp C_NEXT  &kp C_VOLUME_UP    &bt BT_NXT      &kp PSCRN       &kp LBRC   &kp LBKT   &kp RBKT   &kp RBRC  &kp PIPE   &none
&none  &kp LCAPS  &kp C_PREV  &kp C_VOLUME_DOWN  &bt BT_PRV      &kp C_BRI_UP    &kp TILDE  &kp GRAVE  &kp SQT    &kp DQT   &kp BSLH   &none
&none  &kp LSLCK  &kp C_PLAY  &kp C_MUTE         &bt BT_CLR_ALL  &kp C_BRI_DN    &kp UNDER  &kp MINUS  &kp EQUAL  &kp PLUS  &kp SLASH  &none
                                      &none      &trans          &studio_unlock  &trans     &trans     &none
            >;
        };
    };
};
